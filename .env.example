# Copy this file to `.env` (repo root, and/or `backend/.env`) and fill in
# real values. NEVER commit your actual `.env` file (it's git-ignored).

# --- LLM provider ------------------------------------------------------
# "openai" (default, tested) or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0

# --- Postgres (prompts, sensor tags/readings, work-order history, LangGraph checkpoints) -
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plant_ops
# Local dev (no Docker): localhost. Inside docker-compose: host "postgres".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plant_ops

# --- Sample data -------------------------------------------------------------
# Where the bundled synthetic sensor readings / equipment metadata /
# maintenance manuals / incident reports live. Local dev: one level up from
# backend/. Docker: mounted read-only at /app/sample-data.
SAMPLE_DATA_DIR=../sample-data

# --- Anomaly detection -------------------------------------------------------
# How many prior hourly readings ingest_reading loads from Postgres as the
# statistical baseline/history window for detect_anomaly.
HISTORY_WINDOW_HOURS=168

# --- Milvus Lite (embedded plant-knowledge semantic search, no server/docker needed) -
MILVUS_LITE_PATH=./data/milvus_plant_knowledge.db
MILVUS_COLLECTION=plant_knowledge_base
KNOWLEDGE_SEARCH_TOP_K=6

# --- API / CORS ----------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
